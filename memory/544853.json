 "operating_notes": [
  {
   "as_of": "2026-09-01T22:07:11+05:30",
   "lab": {
    "at": "2026-09-01T22:07:11+05:30",
    "by": "unknown",
    "doc": "other"
   },
   "source_news_id": "nse-106765173",
   "text": "Fleet-wide CUF was 30.2% in Q1FY27 versus 28.2% a year ago; wind portfolio (190 MW) CUF was 49.9%."
  },
  {
   "as_of": "2026-09-01T22:07:11+05:30",
   "lab": {
    "at": "2026-09-01T22:07:11+05:30",
    "by": "unknown",
    "doc": "other"
   },
   "source_news_id": "nse-106765173",
   "text": "Days receivable outstanding stood at 19 days as on 30 June 2026."
  },
  {
   "as_of": "2026-09-01T22:07:11+05:30",
   "lab": {
    "at": "2026-09-01T22:07:11+05:30",
    "by": "unknown",
    "doc": "other"
   },
   "source_news_id": "nse-106765173",
   "text": "BESS container prices closed at ~$100/kWh all-in; module prices at ₹12.1-12.2/Wp non-DCR."
  },
  {
   "as_of": "2026-10-16T22:04:12+05:30",
   "lab": {
    "at": "2026-10-16T22:04:12+05:30",
    "by": "unknown",
    "doc": "other"
   },
   "source_news_id": "nse-106820727",
   "text": "Aggregate operational capacity stands at ~2,811 MWp and ~603 MWh BESS as of October 16, 2026."
  },
  {
   "as_of": "2026-10-22T11:52:12+05:30",
   "lab": {
    "at": "2026-10-22T11:52:12+05:30",
    "by": "unknown",
    "doc": "other"
   },
   "source_news_id": "nse-106824490",
   "text": "The 550.6 MWp FDRE project of Juniper Green Stellar stands at 467.35 MWp and ~201 MWh BESS after commissioning 33 MW of wind on October 21, 2026."
  },
  {
   "as_of": "2026-10-22T11:52:12+05:30",
   "lab": {
    "at": "2026-10-22T11:52:12+05:30",
    "by": "unknown",
    "doc": "other"
   },
   "source_news_id": "nse-106824490",
   "text": "Aggregate operational capacity is ~2,844 MWp and ~603 MWh BESS."
  },
  {
   "as_of": "2026-10-22T21:49:37+05:30",
   "lab": {
    "at": "2026-10-22T21:49:37+05:30",
    "by": "unknown",
    "doc": "other"
   },
   "source_news_id": "nse-106825509",
   "text": "Juniper Green Spark Ten's 100 MW hybrid project (75 MW AC solar, 108.75 MW DC, plus 25 MW wind) in Maharashtra was fully commissioned by September 2026, ahead of the November 2026 COD, with a 25-year MSEDCL PPA at ₹3.60/kWh."
  },
  {
   "as_of": "2026-10-22T21:49:37+05:30",
   "lab": {
    "at": "2026-10-22T21:49:37+05:30",
    "by": "unknown",
    "doc": "other"
   },
   "source_news_id": "nse-106825509",
   "text": "CARE expects the SPV's TD/EBITDA to stay above 5.5x over the medium term, with average DSCR of 1.5x in its base case and a two-quarter DSRA requirement."
  },
  {
   "as_of": "2026-10-22T21:49:37+05:30",
   "lab": {
    "at": "2026-10-22T21:49:37+05:30",
    "by": "unknown",
    "doc": "other"
   },
   "source_news_id": "nse-106825509",
   "text": "MSEDCL payment security is an LC equal to one month's average billing; solar billing collection days have averaged under 30."
  }
 ],
