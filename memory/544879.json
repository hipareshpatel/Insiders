  "source_news_id": "nse-106779959",
  "text": "Lalithaa Jewellery Mart is a South India-focused jewellery retailer with 65 stores in 55 cities, selling mainly gold (92% of revenue) with in-house manufacturing in Chennai and Kanchipuram."
 },
 "call_points": [
  {
   "category": "Margins & costs",
   "date": "2026-09-14",
   "lab": {
    "at": "2026-09-14",
