   "category": "Guidance",
   "date": "2026-09-13",
   "news_id": "nse-106779877",
   "text": "FY27 leasing target of 6.5 million sq ft, about 30% growth over last fiscal."
  },
  {
   "category": "Guidance",
   "date": "2026-09-13",
   "news_id": "nse-106779877",
   "text": "FY27 completion target of 6 million sq ft, taking operational area to nearly 35 million sq ft."
  },
  {
   "category": "Guidance",
   "date": "2026-09-13",
   "news_id": "nse-106779877",
   "text": "P&L expected to turn black from Q2/Q3 FY27."
  },
  {
   "category": "Capex & capacity",
   "date": "2026-09-13",
   "news_id": "nse-106779877",
   "text": "In-city platform to deliver 6 million sq ft over three years, first Pune delivery in Q4FY27."
  },
  {
   "category": "Demand & orders",
   "date": "2026-09-13",
   "news_id": "nse-106779877",
   "text": "Re-leasing spread of 12% in Q1FY27, over and above 5% contractual escalation."
  },
  {
   "category": "Margins & costs",
   "date": "2026-09-13",
   "news_id": "nse-106779877",
   "text": "Current debt cost 8.2%; expects 40-50 bps reduction after deleveraging and rating improvement."
  }
