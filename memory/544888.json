 ],
 "business_summary": {
  "as_of": "2026-09-21T20:46:50+05:30",
  "source_news_id": "nse-106786697",
  "text": "Augmont Enterprises runs an asset-light precious metals platform: bullion SPOT trading, digital gold and silver, coins and bars, EMI jewellery, gold loans through partners, sell-old-gold recycling, and gold and silver refining through two facilities with 284 MTPA total capacity."
 },
 "call_points": [
  {
   "category": "Guidance",
   "date": "2026-09-21",
   "news_id": "nse-106786697",
   "text": "No numeric FY27 revenue or margin guidance; management only expects scrap-sourcing relationships to improve margins over coming quarters."
  },
  {
   "category": "Demand & orders",
   "date": "2026-09-21",
   "news_id": "nse-106786697",
   "text": "Revenue from operations grew 30% YoY to ₹18,946 Cr despite a seasonally soft Q1 and Middle East disruption."
  },
  {
   "category": "Balance sheet & funding",
   "date": "2026-09-21",
   "news_id": "nse-106786697",
   "text": "Gold loan AUM, serviced by partner lender Finkurve, expanded 134% YoY to ₹1,270 Cr."
  },
  {
   "category": "Margins & costs",
   "date": "2026-09-21",
   "news_id": "nse-106786697",
   "text": "EBITDA margin rose to 0.44% from 0.31% in Q4FY26 and PAT margin to 0.32% from 0.22% sequentially."
  },
  {
   "category": "Margins & costs",
   "date": "2026-09-21",
   "news_id": "nse-106786697",
   "text": "Accelerated domestic scrap-gold sourcing carried a near-term cost of acquisition that compressed margins, described as a deliberate trade-off."
  },
  {
   "category": "Risks",
   "date": "2026-09-21",
   "news_id": "nse-106786697",
   "text": "PAT fell year on year because international sales were unusually concentrated in Q1 of the prior year and Middle East disruption hit export volumes."
  },
  {
   "category": "Other",
   "date": "2026-09-21",
   "news_id": "nse-106786697",
   "text": "International sales recovered sequentially from Q4FY26, which management reads as gradual normalisation of the export channel."
  },
  {
   "category": "Other",
   "date": "2026-09-21",
   "news_id": "nse-106786697",
   "text": "The company signed an MOU with NSE for Electronic Gold Receipts, expected to launch this financial year."
  }
 ],
