 ],
 "business_summary": {
  "as_of": "2026-09-28T18:36:27+05:30",
  "lab": {
   "at": "2026-09-28T18:36:27+05:30",
   "by": "ai",
   "doc": "call"
  },
  "source_news_id": "nse-106798583",
  "text": "Symbiotec Pharmalab is a steroid and hormones API maker with 60 corticosteroid and steroidal hormone APIs, 44 US DMFs and 25 CEPs, which is building biotech CDMO (fermentation) and complex injectables (dual-chamber vial) verticals."
 },
 "call_points": [
  {
   "category": "Margins & costs",
   "date": "2026-09-28",
   "lab": {
    "at": "2026-09-28",
    "by": "ai",
    "doc": "call"
   },
   "news_id": "nse-106798583",
   "text": "New-business opex of ₹23 Cr and depreciation of ₹11 Cr a quarter should continue for the next two to three quarters."
  },
  {
   "category": "Demand & orders",
   "date": "2026-09-28",
   "lab": {
    "at": "2026-09-28",
    "by": "ai",
    "doc": "call"
   },
   "news_id": "nse-106798583",
   "text": "Existing 400 kL fermentation capacity is largely booked; Phase 1 would be four times current capacity within two to three years."
  },
  {
   "category": "Demand & orders",
   "date": "2026-09-28",
   "lab": {
    "at": "2026-09-28",
    "by": "ai",
    "doc": "call"
   },
   "news_id": "nse-106798583",
   "text": "First DCV ANDA filed this month; second filing scheduled for Q4FY27, with five to six more products developed."
  },
  {
   "category": "Risks",
   "date": "2026-09-28",
   "lab": {
    "at": "2026-09-28",
    "by": "ai",
    "doc": "call"
   },
   "news_id": "nse-106798583",
   "text": "Premarin generic launch timing is outside the company's control as the partner handles formulation development."
  },
  {
   "category": "Risks",
   "date": "2026-09-28",
   "lab": {
    "at": "2026-09-28",
    "by": "ai",
    "doc": "call"
   },
   "news_id": "nse-106798583",
   "text": "Contract values and exact booked capacities withheld, citing customer confidentiality; only 'multi-million dollars' per contract."
  },
  {
   "category": "Other",
   "date": "2026-09-28",
   "lab": {
    "at": "2026-09-28",
    "by": "ai",
    "doc": "call"
   },
   "news_id": "nse-106798583",
   "text": "API is over 90% of revenue now and expected to fall below half in five to six years as new verticals scale."
  }
 ],
