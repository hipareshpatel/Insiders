 "business_summary": {
  "as_of": "2026-10-14T14:10:35+05:30",
  "source_news_id": "nse-106817142",
  "text": "Kanohar Electricals manufactures high-voltage power transformers up to 500 MVA 400 kV, Scott-connected railway transformers, and executes substation and transmission EPC projects."
 },
 "call_points": [
  {
   "category": "Guidance",
   "date": "2026-10-14",
   "news_id": "nse-106817142",
   "text": "Targeting approximately ₹950 Cr revenue in FY27 with EBITDA margins broadly similar to FY26."
  },
  {
   "category": "Demand & orders",
   "date": "2026-10-14",
   "news_id": "nse-106817142",
   "text": "Railways envisage 1,000 traction substations requiring ~2,000 Scott transformers worth ~₹20,000 Cr over 5-10 years."
  },
  {
   "category": "Balance sheet & funding",
   "date": "2026-10-14",
   "news_id": "nse-106817142",
   "text": "Working capital cycle stands at roughly 120 days, comprised of 120 receivable days and 80 inventory days."
  },
  {
   "category": "Risks",
   "date": "2026-10-14",
   "news_id": "nse-106817142",
   "text": "Supply chain planning is viewed as the primary operational risk to maintaining execution timelines."
  }
 ],
