 "business_summary": {
  "as_of": "2026-10-09T17:38:47+05:30",
  "source_news_id": "nse-106812811",
  "text": "Karamtara Engineering manufactures lattice transmission towers, solar mounting structures and trackers, wind towers and fasteners, with 13 manufacturing facilities across India and Italy and exports to over 50 countries."
 },
 "call_points": [
  {
   "category": "Guidance",
   "date": "2026-10-09",
   "news_id": "nse-106812811",
   "text": "FY27 revenue growth guided at 60-65% over FY26."
  },
  {
   "category": "Guidance",
   "date": "2026-10-09",
   "news_id": "nse-106812811",
   "text": "No FY28 revenue guidance; management said it will speak more as the year pans out."
  },
  {
   "category": "Margins & costs",
   "date": "2026-10-09",
   "news_id": "nse-106812811",
   "text": "Q1 EBITDA margin was 11%, hit by high freight and local delivery costs; margins expected to improve as assets are sweated."
  },
  {
   "category": "Margins & costs",
   "date": "2026-10-09",
   "news_id": "nse-106812811",
   "text": "Q1FY26 EBITDA margin was 13%; management declined to give a specific margin target."
  },
  {
   "category": "Capex & capacity",
   "date": "2026-10-09",
   "news_id": "nse-106812811",
   "text": "Bhuj facility started; peak capacity expected in next 6-9 months."
  },
  {
   "category": "Capex & capacity",
   "date": "2026-10-09",
   "news_id": "nse-106812811",
   "text": "PEB facility for data centres expected to start by beginning of next financial year."
  },
  {
   "category": "Balance sheet & funding",
   "date": "2026-10-09",
   "news_id": "nse-106812811",
   "text": "FY26 EBITDA was about ₹500 Cr and cash conversion about ₹675 Cr."
  },
  {
   "category": "Other",
   "date": "2026-10-09",
   "news_id": "nse-106812811",
   "text": "Q1 sales volume was about 135,000 tons."
  }
 ],
