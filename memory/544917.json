 "operating_notes": [
  {
   "as_of": "2026-10-09T17:38:47+05:30",
   "source_news_id": "nse-106812811",
   "text": "Installed capacity stood at 889,200 metric tons per annum as of Q1FY27, excluding captive rolling and galvanizing."
  },
  {
   "as_of": "2026-10-09T17:38:47+05:30",
   "source_news_id": "nse-106812811",
   "text": "Q1FY27 sales volume was about 135,000 tons."
  },
  {
   "as_of": "2026-10-09T17:38:47+05:30",
   "source_news_id": "nse-106812811",
   "text": "US tariff cost in Q1FY27 was about ₹250 Cr, part of other expenses, fully passed through to customers."
  },
  {
   "as_of": "2026-10-20T16:50:28+05:30",
   "source_news_id": "nse-106822774",
   "text": "FY26 sales volume was 3.90 million MTPA (FY25: 2.92 million MTPA), with EBITDA/tonne of INR12,844 (INR11,890)."
  },
  {
   "as_of": "2026-10-20T16:50:28+05:30",
   "source_news_id": "nse-106822774",
   "text": "Net working capital cycle was 143 days in FY26 (FY25: 165 days), with free cash flow negative INR4,379 million in FY26."
  },
  {
   "as_of": "2026-10-20T16:50:28+05:30",
   "source_news_id": "nse-106822774",
   "text": "Saudi Arabia project cost is estimated at INR4,050 million, with INR3,300 million debt sanctioned and about INR2,000 million disbursed; it is set to add 0.22 million MTPA and start revenue from FY28."
  }
 ],
