{
  "name": "bse-intelligence-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply bse-index-nse --local --persist-to ../data/wrangler",
    "db:migrate:remote": "wrangler d1 migrations apply bse-index-nse --remote",
    "test": "node --test --experimental-strip-types --no-warnings test/cardText.test.ts test/company.test.ts test/ownerHold.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.151.0"
  }
}
