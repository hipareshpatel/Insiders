{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insiders",  // served at insiders.<subdomain>.workers.dev
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bse-index-nse",
      // Replace with the id printed by `wrangler d1 create bse-index-nse` (deploy-web.yml does, from the D1_DATABASE_ID
      // repository variable). Local dev keeps the placeholder id, so the laptop's local database stays where it is.
      "database_id": "f1465085-72e3-4a72-a67e-1a6ca9ab202e",   // created by the owner 2026-10-20, Asia Pacific
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "VAULT", "bucket_name": "bse-intelligence" }],
  // Workers AI: the gateway's keyless spare provider (see /api/internal/ai).
  // Workers AI only runs on Cloudflare: local dev calls it remotely (needs `npx wrangler login`).
  "ai": { "binding": "AI", "remote": true },
  "observability": { "enabled": true }
  // Secret (not in this file): INGEST_TOKEN, via `wrangler secret put INGEST_TOKEN`.
}
